# Copy this file to .env and change what you need:  cp .env.example .env

# Port on this machine that the site is published on
PORT=8000

# Which network interface to listen on. 0.0.0.0 = all interfaces, 127.0.0.1 = only this machine.
BIND_ADDRESS=0.0.0.0

# Number of gunicorn worker processes
WEB_CONCURRENCY=2

# gunicorn log level: debug, info, warning, error
LOG_LEVEL=info
